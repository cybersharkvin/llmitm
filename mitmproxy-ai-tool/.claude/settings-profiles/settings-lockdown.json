{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/query-atomization.sh",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "api.anthropic.com",
        "*.anthropic.com",
        "claude.ai",
        "*.claude.ai",
        "statsig.anthropic.com",
        "sentry.io",
        "*.sentry.io"
      ]
    }
  }
}
